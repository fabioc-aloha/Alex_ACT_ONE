node_modules/
*.log
.DS_Store

# Snapshots and console logs the alex-playwright MCP server writes into the
# working directory during render-verify. Produced on every host, so ignoring
# them here keeps a verification run from staging its own scratch output.
.playwright-mcp/

# Frozen, reviewed recovery evidence is a deliverable, not disposable run output.
!archive/verification/session-recovery/history/**/*.log

# Reproducible candidate runtime package; delivery still requires a separate release.
/dist/alex-act-one/